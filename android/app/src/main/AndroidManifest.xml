<?xml version="1.0" encoding="utf-8"?>
<!--
  HorseSafe 0.3.0-Miller deel 1 — minimaal manifest (A-14, A-15, kritiek 4 + 12), uitgebreid in
  0.3.4-Miller deel 2 (telefoon koppelen, HARDWARE_KEYS §13.9):
  - INTERNET alleen voor de device-API; network_security_config laat uitsluitend icthorsecloud.nl toe
    (pins ISRG Root X1 + X2, geen cleartext). Geen ACCESS_NETWORK_STATE, geen FCM.
  - USE_BIOMETRIC voor BiometricPrompt (alleen BIOMETRIC_STRONG met CryptoObject); nooit een
    toestel-PIN als alternatief. USE_FINGERPRINT (API < 28) blijft verwijderd.
  - CAMERA alleen voor de QR-scanner; de app vraagt hem pas bij het scannen. De zxing-CaptureActivity
    is verwijderd: de scanner draait in het eigen FLAG_SECURE-venster.
  - GEEN USB intent-filter / device_filter.xml: detectie alleen via startUsbDiscovery terwijl de app open is.
  - yubikit OtpActivity + YubiKeyPromptActivity verwijderd.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.NFC" />
    <uses-permission android:name="android.permission.HIDE_OVERLAY_WINDOWS" />
    <uses-permission android:name="android.permission.DETECT_SCREEN_CAPTURE" />
    <uses-permission android:name="android.permission.DETECT_SCREEN_RECORDING" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.CAMERA" />

    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />
    <uses-permission android:name="android.permission.USE_FINGERPRINT" tools:node="remove" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" tools:node="remove" />

    <uses-feature android:name="android.hardware.usb.host" android:required="false" />
    <uses-feature android:name="android.hardware.nfc" android:required="false" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:allowBackup="false"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:hasFragileUserData="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.HorseSafe"
        tools:targetApi="35">

        <activity
            android:name=".app.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|keyboard|keyboardHidden|uiMode|navigation|fontScale"
            android:windowSoftInputMode="stateAlwaysHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- yubikit-AAR: niet gebruikte UI-activities weg (A-15). -->
        <activity
            android:name="com.yubico.yubikit.android.ui.OtpActivity"
            tools:node="remove" />
        <activity
            android:name="com.yubico.yubikit.android.ui.YubiKeyPromptActivity"
            tools:node="remove" />

        <!-- zxing-android-embedded: eigen scan-activity weg; de scanner zit als view in MainActivity. -->
        <activity
            android:name="com.journeyapps.barcodescanner.CaptureActivity"
            tools:node="remove" />

        <!--
          androidx.startup: geen providers of services (A-15). De initializers (emoji2, lifecycle-process,
          profileinstaller) zijn niet nodig: Compose gebruikt EmojiCompat alleen als die geconfigureerd is,
          en de app gebruikt ProcessLifecycleOwner niet (alleen de lifecycle van de activity).
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            tools:node="remove"
            tools:ignore="MissingClass" />

        <!-- androidx.profileinstaller: exported receiver; niet nodig, één exported component (A-15). -->
        <receiver
            android:name="androidx.profileinstaller.ProfileInstallReceiver"
            tools:node="remove"
            tools:ignore="MissingClass" />
    </application>
</manifest>
