// GEGENEREERD door ModelArchDSL — niet met de hand bewerken.
// Bron: archmodel/tobe.archdsl (ontwerp) + archmodel/asis.facts.json (code).
set language archimate
set title "HorseSafe — Klantreis: kluis openen met wachtwoord en/of keyfile"
set subtitle "Klantreis (stappen genummerd, afspeelbaar in het portaal)"
set purpose "Login + MFA, ciphertext ophalen, ontsleutelen in de browser, wijzigen en opslaan met If-Match (SQ-4, SQ-5)."
show legend true
switch badges on
set current state "As-is (code)"
set target state "To-be (ontwerp)"

Group laag_business "Business" {
    -width 1220
    -height 310
}
BusinessActor ba_gebruiker "Eindgebruiker (Christian)" in laag_business {
    -attr status = "ontwerp"
}
BusinessProcess bp_inloggen "Inloggen met accountwachtwoord" in laag_business {
    -step 1
    -attr status = "ontwerp"
}
BusinessProcess bp_mfa "Tweede stap: TOTP-code, magic-link of backup-code" in laag_business {
    -step 2
    -attr status = "ontwerp"
}
BusinessProcess bp_blob_ophalen "Versleutelde KDBX4-blob + ETag ophalen" in laag_business {
    -step 3
    -attr status = "ontwerp"
}
BusinessProcess bp_ontsleutelen_pw "Ontsleutelen met wachtwoord en/of keyfile in de browser" in laag_business {
    -step 4
    -attr status = "ontwerp"
}
BusinessProcess bp_opslaan "Bewerken en opslaan met If-Match" in laag_business {
    -step 5
    -attr status = "ontwerp"
}
BusinessService bs_kluis "Zero-knowledge wachtwoordkluis" in laag_business {
    -attr status = "ontwerp"
}

Group laag_application "Applicatie" {
    -width 820
    -height 180
}
ApplicationComponent ac_auth "Account en MFA (/auth)" in laag_application {
    -stroke "#16a34a"
    -attr status = "gebouwd"
    -attr trace = "route:POST /register, route:POST /login, route:POST /logout, route:GET /me, route:POST /password, route:POST /totp/*, route:* /magic-link*, route:POST /backup-codes/*, dep:pip:pyotp, dep:pip:argon2-cffi, dep:pip:passlib, dep:pip:pyjwt, dep:pip:bcrypt, dep:pip:email-validator, config:HORSESAFE_BCRYPT_ROUNDS"
    -description "Argon2id-wachtwoord, TOTP RFC 6238, magic-link alleen als tweede stap (R14), bcrypt-backup-codes, JWT in HttpOnly-cookie."
}
ApplicationComponent ac_mailer "Mailer (SMTP 587 STARTTLS, Gmail-fallback)" in laag_application {
    -stroke "#16a34a"
    -attr status = "gebouwd"
    -attr trace = "module:backend/services"
    -description "mail_service.py: magic-links en beveiligingsmeldingen; From = SMTP-gebruiker; send_async via asyncio.to_thread."
}
ApplicationComponent ac_browsercrypto "Crypto-engine in de browser (kdbxweb, per-entry TOTP, delen)" in laag_application {
    -stroke "#16a34a"
    -attr status = "gebouwd"
    -attr trace = "module:frontend/js"
    -description "crypto.js, totp.js, sharing.js, import-export.js: alle KDBX4-crypto client-side (P-CRYPT-05)."
}
ApplicationComponent ac_vault "Kluisopslag (/vault, blob-CRUD met If-Match)" in laag_application {
    -stroke "#16a34a"
    -attr status = "gebouwd"
    -attr trace = "route:GET /(vault_id), route:PUT /(vault_id), route:DELETE /(vault_id), route:POST /(vault_id)/audit-export, route:POST /(vault_id)/audit-import"
    -description "Bewaart alleen ciphertext; 412 bij ETag-mismatch; audit-export/-import vóór plaintext-export. GET/POST /vault (leeg pad) staat in de code maar wordt niet gemeten."
}

// Posities (deterministische raster-layout per ArchiMate-laag)
pos laag_business 40, 40
pos ba_gebruiker 60, 90
pos bp_inloggen 260, 90
pos bp_mfa 460, 90
pos bp_blob_ophalen 660, 90
pos bp_ontsleutelen_pw 860, 90
pos bp_opslaan 1060, 90
pos bs_kluis 60, 220
pos laag_application 40, 390
pos ac_auth 60, 440
pos ac_mailer 260, 440
pos ac_browsercrypto 460, 440
pos ac_vault 660, 440

// Relaties — Dragon1-compatibel: werkwoordvorm, of ongetypeerd waar Dragon1 het type afleidt
ba_gebruiker associates bs_kluis "gebruikt"
ac_browsercrypto realizes bs_kluis
ac_auth serves ac_mailer "magic-link"
ac_auth serves bp_inloggen
ac_auth serves bp_mfa
ac_mailer serves bp_mfa
ac_vault serves bp_blob_ophalen
ac_browsercrypto serves bp_ontsleutelen_pw
ac_vault serves bp_opslaan
ac_browsercrypto serves bp_opslaan
bp_ontsleutelen_pw realizes bs_kluis
bp_inloggen -> bp_mfa
bp_mfa -> bp_blob_ophalen
bp_blob_ophalen -> bp_ontsleutelen_pw
bp_ontsleutelen_pw -> bp_opslaan
ba_gebruiker -> bp_inloggen "start"
