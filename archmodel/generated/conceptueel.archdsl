pos bp_backupcodes 460, 960
pos bp_blob_ophalen 660, 960
pos bp_ontsleutelen_pw 860, 960
pos bp_opslaan 1060, 960
pos bp_stepup 60, 1090
pos bp_registreer_sleutel 260, 1090
pos bp_verzegelen 460, 1090
pos bp_server_verifieert 660, 1090
