// Relaties — Dragon1-compatibel: werkwoordvorm, of ongetypeerd waar Dragon1 het type afleidt
dr_zk influences go_kluis "drijft aan"
dr_kdbx influences go_dr "drijft aan"
dr_vinger influences go_hw "drijft aan"
go_kluis influences rq_browsercrypto "vereist"
go_kluis influences rq_twolayers "vereist"
go_kluis influences rq_mfa "vereist"
go_hw influences rq_seal "vereist"
go_hw influences rq_devicebound "vereist"
go_hw influences rq_stepup "vereist"
go_dr influences rq_optlock "vereist"
go_kluis influences rq_export "vereist"
go_kluis influences rq_audit "vereist"
go_kluis influences rq_throttle "vereist"
cn_noescrow influences go_kluis "begrenst"
cn_unblock influences bp_deblokkeren "begrenst"
ba_gebruiker associates bs_kluis "gebruikt"
ba_gebruiker associates bs_account "gebruikt"
ba_gebruiker associates bs_hwsleutel "gebruikt"
ba_gebruiker associates bs_nood "gebruikt"
ba_gebruiker associates bs_importexport "gebruikt"
ba_gebruiker associates bs_delen "gebruikt"
ba_admin associates bs_beheer "gebruikt"
bp_registreren realizes bs_account
bp_ontsleutelen_pw realizes bs_kluis
bp_kopie_openen realizes bs_hwsleutel
bp_nood_ontgrendelen realizes bs_nood
