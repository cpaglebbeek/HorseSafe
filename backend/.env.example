# HorseSafe backend env-template. Productie: /opt/horsesafe/.env (mode 600).
# Dev: kopieer naar backend/.env en pas waarden aan.

# Pad-instellingen
HORSESAFE_DB_PATH=./db/horsesafe.db
HORSESAFE_VAULTS_DIR=./vaults

# JWT (productie: 32 bytes hex via `openssl rand -hex 32`)
HORSESAFE_JWT_SECRET=replace-me-in-production
HORSESAFE_JWT_TTL_MINUTES=720

# Cookies
HORSESAFE_COOKIE_NAME=horsesafe_session
HORSESAFE_COOKIE_SECURE=true
HORSESAFE_COOKIE_SAMESITE=strict

# Argon2id (account-pw hashing — server-side)
HORSESAFE_ARGON2_TIME_COST=3
HORSESAFE_ARGON2_MEMORY_KIB=65536
HORSESAFE_ARGON2_PARALLELISM=4

# Throttle
HORSESAFE_FAILED_LOGIN_MAX=5
HORSESAFE_FAILED_LOGIN_WINDOW_MINUTES=15

# Vault
HORSESAFE_VAULT_MAX_BYTES=52428800

# Mailer (v0.2.0-Koblitz, besluit 4): SMTP met STARTTLS op 587. From = SMTP-gebruiker.
# Waarden alleen in /opt/horsesafe/.env (uit ClaudeSecrets); hier alleen de namen.
# Zonder mailer is noodsleutel-vrijgave uitgeschakeld (503 notify_unavailable).
HORSESAFE_SMTP_HOST=
HORSESAFE_SMTP_PORT=587
HORSESAFE_SMTP_USER=
HORSESAFE_SMTP_PASSWORD=
HORSESAFE_SMTP_FROM=
HORSESAFE_SMTP_STARTTLS=true
HORSESAFE_SMTP_TIMEOUT_SECONDS=15
# Oude fallback (SMTP_SSL 465; werkt niet op HC55)
# HORSESAFE_GMAIL_USER=
# HORSESAFE_GMAIL_APP_PASSWORD=

# Hardware-sleutels (v0.2.0-Koblitz, docs/HARDWARE_KEYS.md §12.2)
HORSESAFE_WEBAUTHN_RP_ID=icthorsecloud.nl
HORSESAFE_WEBAUTHN_ORIGIN=https://icthorsecloud.nl
HORSESAFE_WEBAUTHN_RP_NAME=HorseSafe
HORSESAFE_STEPUP_TTL_SECONDS=300
# Alleen voor tests/dev met rpId localhost; de app weigert te starten met rpId icthorsecloud.nl
HORSESAFE_TEST_ATTESTATION=false

HORSESAFE_LOG_LEVEL=INFO
